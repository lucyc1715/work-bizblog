---
import Base from "../layouts/Base.astro";
---
<Base title="CV">
<section class="route">
  <div class="wrap section">
    <p class="kicker">CV</p>
    <h1 data-split>Lucy Chen</h1>
    <p class="lede prose">Product engineer. I build customer-facing software for regulated finance. Ten years in software, three of them delivering inside a licensed bank, then I shipped my own SaaS solo to 350+ users on iOS, Android and web.</p>
    <p class="avail" style="margin:14px 0 4px"><span class="pulse"></span><span data-site="open">Open to Forward Deployed Engineer roles in Dublin, Amsterdam, Tallinn or EU remote. Available in 4 weeks.</span></p>
    <p class="links-line"><a href="mailto:lucychen.biz@gmail.com">lucychen.biz@gmail.com</a> &middot; <a href="https://linkedin.com/in/lucychen-ai" target="_blank" rel="noopener">linkedin.com/in/lucychen-ai</a> &middot; <a href="https://github.com/lucyc1715" target="_blank" rel="noopener">github.com/lucyc1715</a> &middot; Taipei, relocating to the EU</p>

    <!-- 4-Metric Impact Strip -->
    <div class="metric-strip rv">
      <div class="m-cell">
        <span class="m-num">10 Years</span>
        <span class="m-label">Software Delivery</span>
      </div>
      <div class="m-cell">
        <span class="m-num">9 Devs &amp; 5 Vendors</span>
        <span class="m-label">Bank Team Leadership</span>
      </div>
      <div class="m-cell">
        <span class="m-num">350+ Users</span>
        <span class="m-label">Live Production SaaS</span>
      </div>
      <div class="m-cell">
        <span class="m-num">100% On-Time</span>
        <span class="m-label">Quarterly Release Track</span>
      </div>
    </div>

    <!-- Skills Matrix (Categorized Chips) -->
    <div class="case-sec">
      <h2 class="rv">Skills &amp; Technology Stack</h2>
      <div class="skill-matrix rv">
        <div class="skill-cat">
          <div class="skill-cat-head">
            <h4 class="skill-cat-title"><span>🎨</span> Frontend &amp; Mobile</h4>
            <span class="badge-pill">7 Technologies</span>
          </div>
          <div class="skill-chips">
            <span class="skill-chip hi">Flutter</span>
            <span class="skill-chip hi">Vue 3</span>
            <span class="skill-chip hi">Angular</span>
            <span class="skill-chip hi">TypeScript</span>
            <span class="skill-chip">React</span>
            <span class="skill-chip">Playwright UI Regression</span>
            <span class="skill-chip">Design Systems</span>
          </div>
        </div>

        <div class="skill-cat">
          <div class="skill-cat-head">
            <h4 class="skill-cat-title"><span>☁️</span> Cloud &amp; Backend</h4>
            <span class="badge-pill">6 Technologies</span>
          </div>
          <div class="skill-chips">
            <span class="skill-chip hi">Firebase Cloud Functions</span>
            <span class="skill-chip hi">Firestore</span>
            <span class="skill-chip hi">PostgreSQL</span>
            <span class="skill-chip">GCP</span>
            <span class="skill-chip">REST APIs</span>
            <span class="skill-chip">CI/CD &amp; Linux</span>
          </div>
        </div>

        <div class="skill-cat">
          <div class="skill-cat-head">
            <h4 class="skill-cat-title"><span>💳</span> Fintech, Identity &amp; Security</h4>
            <span class="badge-pill">7 Domains</span>
          </div>
          <div class="skill-chips">
            <span class="skill-chip hi">Stripe</span>
            <span class="skill-chip hi">Apple IAP</span>
            <span class="skill-chip hi">Google Play IAP</span>
            <span class="skill-chip hi">Unified Entitlements</span>
            <span class="skill-chip">PCI DSS</span>
            <span class="skill-chip">Mobile ID</span>
            <span class="skill-chip">KYC / AML</span>
          </div>
        </div>

        <div class="skill-cat">
          <div class="skill-cat-head">
            <h4 class="skill-cat-title"><span>🤖</span> AI Workflows &amp; Governance</h4>
            <span class="badge-pill">6 Practices</span>
          </div>
          <div class="skill-chips">
            <span class="skill-chip hi">Claude Agentic Workflows</span>
            <span class="skill-chip hi">MCP Integration</span>
            <span class="skill-chip hi">PMP Certified</span>
            <span class="skill-chip">Vendor Governance (IBM)</span>
            <span class="skill-chip">Code Review SOPs</span>
            <span class="skill-chip">Agile / Scrum</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Experience Section with Badges -->
    <div class="case-sec">
      <h2 class="rv">Experience</h2>

      <div class="rv" style="margin-bottom:32px">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <h3 style="margin:0">Founder &amp; Product Engineer &middot; LZpreneur O&Uuml;, Estonia (remote)</h3>
          <span class="badge-pill success">Solo 0-to-1 Shipper</span>
        </div>
        <p class="kicker" style="margin:6px 0 12px">Nov 2025 &ndash; present</p>
        <ul class="now-list" style="max-width:none">
          <li><span class="dot"></span><span><strong>Solo Full-Stack Delivery</strong> &mdash; Built and shipped Course Kit alone: Flutter iOS &amp; Android apps plus web storefront, with Apple IAP, Google Play IAP, and Stripe live in production.</span></li>
          <li><span class="dot"></span><span><strong>Unified Entitlement Architecture</strong> &mdash; Cloud Functions normalise all three payment rails into a single Firestore entitlement schema. Conflicts resolve to the highest tier rather than last write, and additive-only schema design enabled a three-tier pricing model with zero regressions.</span></li>
          <li><span class="dot"></span><span><strong>Bootstrapped Traction</strong> &mdash; 8 releases in 8 months across 3 platforms. Acquired 350+ users and 100+ MAU via organic SEO ($0 ad spend), converting into paying customers. Operates alongside full-time employment with zero IP overlap.</span></li>
        </ul>
        <p class="links-line"><a href="/work/coursekit">Course Kit case study &rarr;</a> &middot; <a href="/work/vibe-code-home">Vibe Code Home case study &rarr;</a></p>
      </div>

      <div class="rv" style="margin-bottom:32px">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <h3 style="margin:0">Frontend Engineer &middot; FintechLife, Taipei</h3>
          <span class="badge-pill">Fintech Compliance</span>
        </div>
        <p class="kicker" style="margin:6px 0 12px">Nov 2024 &ndash; present</p>
        <ul class="now-list" style="max-width:none">
          <li><span class="dot"></span><span><strong>PCI DSS Payload Encryption</strong> &mdash; Implemented RSA payload encryption in Vue 3 to meet strict PCI DSS requirements, owning client-side key lifecycle with backend teams. Platform passed external PCI DSS assessment.</span></li>
          <li><span class="dot"></span><span><strong>AI-Assisted Workflow</strong> &mdash; Architected AI-augmented engineering workflows in Claude with layered style conventions and automated quality hooks, accelerating feature delivery from 3 days to 1 day.</span></li>
          <li><span class="dot"></span><span><strong>Global Integration Portal</strong> &mdash; Defined REST API integration specifications with cross-border engineering teams across Lithuania, the US, and Europe. Shipped developer portal in 6 weeks with automated multi-locale Playwright regression tests.</span></li>
        </ul>
      </div>

      <div class="rv" style="margin-bottom:32px">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <h3 style="margin:0">Working Holiday &middot; London, United Kingdom</h3>
          <span class="badge-pill">UK Experience</span>
        </div>
        <p class="kicker" style="margin:6px 0 12px">Jun &ndash; Sep 2024 &middot; UK Youth Mobility Scheme</p>
        <ul class="now-list" style="max-width:none">
          <li><span class="dot"></span><span>Delivered real-time frontend interfaces for a London gaming platform using React, TypeScript, Redux, and WebSocket.</span></li>
        </ul>
      </div>

      <div class="rv emp" style="margin-bottom:32px">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <h3 class="emp-co" style="margin:0">Rakuten International Commercial Bank, Taipei</h3>
          <span class="badge-pill success">Promoted to Lead in 18 Mos</span>
        </div>
        <p class="kicker" style="margin:6px 0 10px">May 2021 &ndash; May 2024 &middot; Taiwan's first digital-only bank</p>

        <div class="emp-roles">
          <div class="emp-role">
            <h4>Tech Team Leader <span class="badge-pill">100% On-Time Delivery</span></h4>
            <p class="emp-when">Nov 2022 &ndash; May 2024</p>
            <ul class="now-list" style="max-width:none">
              <li><span class="dot"></span><span><strong>9-Engineer &amp; 5-Vendor Leadership</strong> &mdash; Led delivery across 5 backend, 2 frontend, and 2 mobile engineers plus 2 outsourcing development vendors. Achieved 100% on-time quarterly delivery (often delivering up to 2 weeks early).</span></li>
              <li><span class="dot"></span><span><strong>Vendor Governance &amp; Review SOPs</strong> &mdash; Managed 5 vendors across HSM, certificate authorities, and application development. Authored the bank's standardized code review SOP still in active use today.</span></li>
              <li><span class="dot"></span><span><strong>Onboarding Acceleration</strong> &mdash; Authored comprehensive Confluence onboarding runbooks, cutting new engineer time-to-first-PR from 3 weeks down to 2 days (85% reduction). Coordinated with Rakuten Japan on group-wide ecosystem API upgrades.</span></li>
            </ul>
          </div>

          <div class="emp-role">
            <h4>Senior Frontend Engineer</h4>
            <p class="emp-when">May 2021 &ndash; Oct 2022</p>
            <ul class="now-list" style="max-width:none">
              <li><span class="dot"></span><span><strong>KYC Re-Verification with IBM</strong> &mdash; Owned bank-side delivery for KYC CDD/EDD re-verification with IBM vendor team. Accepted into production against Taiwan FSC regulatory guidelines with 1/3/5-year AML risk-tier cycles.</span></li>
              <li><span class="dot"></span><span><strong>Mobile ID Device Binding</strong> &mdash; Engineered SIM-to-handset verification gate via telco Mobile ID to secure high-value transfers; reused module across 4 critical payment flows.</span></li>
              <li><span class="dot"></span><span><strong>PwC Audit Closure</strong> &mdash; Migrated sensitive client storage to IndexedDB, resolving and closing 15/15 external security assessment findings from PwC.</span></li>
            </ul>
          </div>
        </div>

        <p class="links-line"><a href="/work/licensed-bank-delivery">Licensed bank delivery case study &rarr;</a></p>
      </div>

      <div class="rv" style="margin-bottom:30px">
        <h3>Frontend Engineer &middot; Shengsen Cloud Technology, Taipei</h3>
        <p class="kicker" style="margin:6px 0 10px">Nov 2020 &ndash; Mar 2021 &middot; On site at Far Eastern International Bank</p>
        <ul class="now-list" style="max-width:none">
          <li><span class="dot"></span><span>Designed and built a logistics management system in React and TypeScript, integrating DHL APIs and cutting manual team coordination by 40%.</span></li>
        </ul>
      </div>

      <div class="rv" style="margin-bottom:30px">
        <h3>Project Coordinator &middot; Wistron ITS, Taipei</h3>
        <p class="kicker" style="margin:6px 0 10px">Oct 2016 &ndash; Jun 2019 &middot; On site at Foxconn H2U</p>
        <ul class="now-list" style="max-width:none">
          <li><span class="dot"></span><span>Coordinated delivery between PMs, SAs, and engineering teams. Authored 200+ manual and automated test cases, lifting system test coverage by 30%.</span></li>
        </ul>
      </div>

      <div class="rv">
        <h3>Software Engineer &middot; Smart Catch Inc., Taipei</h3>
        <p class="kicker" style="margin:6px 0 10px">Aug 2015 &ndash; Oct 2016 &middot; Java, Spring MVC, MySQL, REST</p>
      </div>
    </div>

    <!-- Certifications and Education -->
    <div class="case-sec">
      <h2 class="rv">Certifications &amp; Education</h2>
      <table class="cheat-sheet rv">
        <thead>
          <tr>
            <th>Credential</th>
            <th>Issuing Body / Institution</th>
            <th>Year / Validity</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Project Management Professional (PMP)&reg;</strong></td>
            <td>Project Management Institute (PMI)</td>
            <td><span class="badge-pill success">Active</span> Sep 2025</td>
          </tr>
          <tr>
            <td><strong>AWS Certified Cloud Practitioner (CLF-C02)</strong></td>
            <td>Amazon Web Services</td>
            <td><span class="badge-pill success">Active</span> 2024 &ndash; Oct 2027</td>
          </tr>
          <tr>
            <td><strong>MA Music Industry Studies (Merit)</strong></td>
            <td>University of Liverpool, United Kingdom</td>
            <td>2019 &ndash; 2020</td>
          </tr>
          <tr>
            <td><strong>BBA Information Management</strong></td>
            <td>Chihlee University of Technology, Taipei</td>
            <td>2011 &ndash; 2015 (Qualifying ICT Degree)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Hiring & Logistics Cheat Sheet -->
    <div class="case-sec">
      <h2 class="rv">Recruiter &amp; Hiring FAQ Cheat Sheet</h2>
      <table class="cheat-sheet rv">
        <thead>
          <tr>
            <th>Hiring Dimension</th>
            <th>Candidate Status</th>
            <th>Key Verification Detail</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Permit Route</strong></td>
            <td><span class="badge-pill success">CSEP / HSM Eligible</span></td>
            <td>Software engineering is on Ireland's Critical Skills list; BBA in Information Management is the qualifying ICT degree.</td>
          </tr>
          <tr>
            <td><strong>Relocation Targets</strong></td>
            <td><span class="badge-pill">Dublin / Amsterdam / Tallinn</span></td>
            <td>Open to on-site work, customer travel, and hybrid/remote setups in Europe.</td>
          </tr>
          <tr>
            <td><strong>Notice Period</strong></td>
            <td><span class="badge-pill success"><span data-site="notice">4 weeks</span></span></td>
            <td>Currently employed in Taipei; ready for planned transition and relocation.</td>
          </tr>
          <tr>
            <td><strong>English Proficiency</strong></td>
            <td><span class="badge-pill">Full Professional</span></td>
            <td>Master's taught &amp; awarded in English by a UK institution (University of Liverpool); daily collaboration with European/US engineering teams.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
</Base>
